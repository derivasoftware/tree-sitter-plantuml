{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "plantuml",
      "camelcase": "Plantuml",
      "title": "PlantUML",
      "scope": "source.plantuml",
      "path": ".",
      "file-types": [
        "puml",
        "plantuml",
        "iuml",
        "wsd"
      ],
      "injection-regex": "^(plant)?uml$"
    }
  ],
  "metadata": {
    "version": "0.16.1",
    "license": "MIT",
    "description": "PlantUML grammar for tree-sitter",
    "authors": [
      {
        "name": "dcoello-dev"
      }
    ],
    "links": {
      "repository": "https://github.com/derivasoftware/tree-sitter-plantuml"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
